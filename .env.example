# =============================================================================
# ExpenseChain Backend Deployment Environment Variables
# =============================================================================

# Server Port (Render automatically sets $PORT; defaults to 8080 locally)
PORT=8080

# PostgreSQL Database Connection (Supabase / Render PostgreSQL)
# Supports both postgres:// and postgresql:// URIs, or standard JDBC URL
DATABASE_URL=postgres://user:password@hostname:5432/dbname
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-password

# Corda RPC Credentials & Network Configuration
CORDA_RPC_USERNAME=user1
CORDA_RPC_PASSWORD=your-rpc-password

CORDA_GARVIT_HOST=garvit
CORDA_GARVIT_RPC_PORT=10006
CORDA_GARVIT_X500=O=Garvit,L=New Delhi,C=IN

CORDA_ARNAV_HOST=arnav
CORDA_ARNAV_RPC_PORT=10009
CORDA_ARNAV_X500=O=Arnav,L=Mumbai,C=IN

CORDA_MRIDUL_HOST=mridul
CORDA_MRIDUL_RPC_PORT=10012
CORDA_MRIDUL_X500=O=Mridul,L=Bengaluru,C=IN

CORDA_NOTARY_X500=O=Notary,L=London,C=GB
