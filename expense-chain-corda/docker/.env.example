# Corda 4.11 Docker Network Environment Configuration
# Copy this file to .env before starting containers if custom RPC credentials are required.

# License acceptance required by official Corda community Docker image
ACCEPT_LICENSE=Y

# JVM arguments for node memory optimization
JVM_ARGS=-Xmx512m -Xms256m -XX:+UseG1GC

# Corda RPC credentials (must match backend application.properties)
CORDA_RPC_USERNAME=user1
CORDA_RPC_PASSWORD=test
